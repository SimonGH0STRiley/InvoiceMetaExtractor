{
  "name": "invoice-meta-extractor-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n api,web \"npm run start:api\" \"npm run start:web\"",
    "start:api": "python -m uvicorn api.server:app --host 127.0.0.1 --port 8000",
    "start:web": "ng serve --host 127.0.0.1 --port 4200 --proxy-config frontend/proxy.conf.json",
    "build": "ng build",
    "build:dev": "ng build --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ant-design/icons-angular": "^21.0.0",
    "ng-zorro-antd": "^21.0.0",
    "rxjs": "latest",
    "tslib": "latest",
    "zone.js": "latest"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^10.0.3",
    "typescript": ">=5.9.0 <6.0.0"
  }
}
